PORT=3500
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/starlink?retryWrites=true&w=majority
MONGODB_DB_NAME=starlink
JWT_SECRET_KEY=replace-with-a-long-random-secret
SESSION_DAYS=7

# Local:
CLIENT_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
AUTH_COOKIE_SECURE=false
NODE_ENV=development

# Production example:
# CLIENT_ORIGINS=https://your-starlink-domain.com
# PUBLIC_APP_URL=https://your-starlink-domain.com
# AUTH_COOKIE_SECURE=true
# NODE_ENV=production
PROFILE_CREATE_KEY=STARLINK_LOCAL_CREATE_KEY
